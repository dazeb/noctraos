#!/usr/bin/env bash
# noctraos-hermes — Hermes Desktop launcher and installer.
#   noctraos-hermes            launch the app (installs it first if missing)
#   noctraos-hermes install    idempotent: runtime + desktop app + model defaults (a fresh install is the newest release)
#   noctraos-hermes update     move to the newest published release: the old code is set aside, the release is installed,
#                              and the old code comes back if anything fails (your ~/.hermes data is never touched)
#   noctraos-hermes local [--no-launch]   local-only: Ollama is the primary and the Nous free tier stays off,
#                              so nothing typed to Hermes leaves this computer (persistent)
#   noctraos-hermes cloud     back to the Nous free tier (undoes `local`; never touches your own provider)
#   noctraos-hermes mode       print cloud | local | other
#   noctraos-hermes ready      exit 0 when the runtime and the desktop app are both built
#   noctraos-hermes status     print what is installed / configured
#
# First-run onboarding: until ~/.hermes/.noctraos-onboarded exists, the launch
# sets HERMES_EPHEMERAL_SYSTEM_PROMPT (request-time only, never stored in the
# chat) from onboarding.md. Hermes Desktop opens with its own greeting; the
# prompt makes the agent start the NoctraOS tour from the user's first reply.
# The prompt tells the agent to create the marker when the tour is finished.
#
# Model defaults, free by design:
#   1. Hermes' own free tier (Nous · free tier): the desktop mints an anonymous
#      identity at boot when HERMES_GUEST_ONBOARDING=1, so first launch just works
#      with no signup. We never set model.provider, which is what lets it win.
#   2. Local Ollama as a fallback_providers entry, used when the free tier is
#      unreachable (offline, rate-limited). If the machine has never reached the
#      free tier and is offline at launch, Ollama becomes the primary instead.
set -u

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
RUNTIME="$HERMES_HOME/hermes-agent"
HERMES_BIN="$HOME/.local/bin/hermes"
OLLAMA_API="${NOCTRAOS_OLLAMA_API:-http://127.0.0.1:11434}"
# Default model: NOCTRAOS_MODEL, then the file `noc models default` writes, then the shipped model.
OLLAMA_MODEL="${NOCTRAOS_MODEL:-$(head -n 1 "${XDG_CONFIG_HOME:-$HOME/.config}/noctraos/model" 2>/dev/null)}"
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5-coder:7b}"
INSTALLER_URL="${NOCTRAOS_HERMES_INSTALLER_URL:-https://hermes-agent.nousresearch.com/install.sh}"
NOC_UPSTREAM="${NOC_UPSTREAM:-/usr/local/bin/noc-upstream}"
NOUS_URL="https://portal.nousresearch.com"
ONBOARD_FILE="${NOCTRAOS_HERMES_ONBOARDING:-/usr/local/share/noctraos/hermes/onboarding.md}"
ONBOARD_DONE="$HERMES_HOME/.noctraos-onboarded"

# mise-managed node/npm lives behind the profile hooks; the desktop build needs it.
if [ -f /etc/profile.d/noctraos-mise.sh ]; then
  # shellcheck disable=SC1091
  . /etc/profile.d/noctraos-mise.sh
fi
export PATH="$HOME/.local/bin:$PATH"

say() { printf '[noctraos-hermes] %s\n' "$*"; }

runtime_ready() {
  [ -f "$RUNTIME/.hermes-bootstrap-complete" ] && [ -x "$HERMES_BIN" ]
}

app_ready() {
  local d n
  for d in linux-unpacked linux-arm64-unpacked; do
    for n in hermes Hermes; do
      [ -x "$RUNTIME/apps/desktop/release/$d/$n" ] && return 0
    done
  done
  return 1
}

ollama_ready() {
  curl -fsS --max-time 3 "$OLLAMA_API/api/tags" 2>/dev/null \
    | jq -e --arg m "$OLLAMA_MODEL" '.models[]? | select(.name == $m or .name == ($m + ":latest"))' \
      >/dev/null 2>&1
}

# True if config.yaml has the given top-level key, or "section.key" one level down.
config_has() {
  local f="$HERMES_HOME/config.yaml"
  [ -f "$f" ] || return 1
  case "$1" in
    *.*)
      awk -v sec="${1%%.*}" -v k="${1#*.}" '
        $0 ~ "^"sec":" {m=1; next}
        /^[^ #\t]/ {m=0}
        m && $1 == k":" {f=1}
        END {exit !f}' "$f" ;;
    *) grep -q "^$1:" "$f" ;;
  esac
}

# model.provider counts as explicit only when set to something other than the
# stock "auto" (or empty): auto is Hermes' default and leaves the free tier in play.
explicit_provider() {
  local f="$HERMES_HOME/config.yaml" v
  [ -f "$f" ] || return 1
  v="$(awk '
    /^model:/ {m=1; next}
    /^[^ #\t]/ {m=0}
    m && $1 == "provider:" {sub(/^[ \t]*provider:[ \t]*/, ""); sub(/[ \t]*#.*$/, ""); gsub(/["\x27]/, ""); print; exit}' "$f")"
  [ -n "$v" ] && [ "$v" != "auto" ]
}

# `hermes desktop` writes its own launcher (com.nousresearch.hermes.desktop) on every run, which
# would be a second "Hermes" next to ours (our wrapper sets the free tier and the onboarding
# prompt, theirs does not). Hide it, then stop it being rewritten: Hermes honours
# desktop.manage_launcher_entry=false for an entry that already exists.
hide_hermes_own_launcher() {
  local e="$HOME/.local/share/applications/com.nousresearch.hermes.desktop"
  [ -f "$e" ] || return 0
  if ! grep '^NoDisplay=true' "$e" >/dev/null; then
    awk '/^NoDisplay=/ {next} {print} /^\[Desktop Entry\]/ {print "NoDisplay=true"}' "$e" > "$e.new" \
      && mv "$e.new" "$e"
  fi
  config_has desktop.manage_launcher_entry || hermes_set desktop.manage_launcher_entry false
}

hermes_set() { "$HERMES_BIN" config set "$@" >/dev/null 2>&1; }

# The newest published release, read from GitHub Releases by noc-upstream: its git tag, and its version.
# Hermes' own `hermes update` can only follow a branch (main is days ahead of the last release) and its release
# channels are not published yet, so NoctraOS pins the official installer to the release tag itself.
release_tag() { [ -x "$NOC_UPSTREAM" ] && "$NOC_UPSTREAM" latest hermes --tag 2>/dev/null; }
release_version() { [ -x "$NOC_UPSTREAM" ] && "$NOC_UPSTREAM" latest hermes 2>/dev/null; }

# The installed version ("0.21.6"), whatever else `hermes --version` prints after it.
installed_version() {
  [ -x "$HERMES_BIN" ] || return 1
  "$HERMES_BIN" --version 2>/dev/null | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1
}

install_runtime() {
  runtime_ready && { say "OK: Hermes runtime present"; return 0; }
  local tag
  tag="$(release_tag)" || tag=""
  if [ -n "$tag" ]; then
    say "Installing the Hermes runtime (official installer, release $tag)..."
  else
    say "WARNING: could not read the latest Hermes release; installing the installer's default branch instead"
  fi
  curl -fsSL "$INSTALLER_URL" | bash -s -- --skip-setup ${tag:+--branch "$tag"} || return 1
  runtime_ready
}

# True while Hermes (the desktop app, its background service, a terminal session) runs from the runtime directory.
hermes_running() { pgrep -f "$RUNTIME/" >/dev/null 2>&1; }

build_app() {
  app_ready && { say "OK: Hermes Desktop app already built"; return 0; }
  say "Building Hermes Desktop — a few minutes, downloads Electron..."
  "$HERMES_BIN" desktop --build-only || return 1
  app_ready
}

# Chromium in a VM (no GPU, no usable sandbox helpers) can crash the renderer
# ("Renderer process crashed", blank window): /dev/shm shared-memory failures and
# the sandbox. Hermes already falls back to --no-sandbox by itself when its sandbox
# fails; on VMs we start there rather than discover it via a blank window.
# --disable-dev-shm-usage makes Chromium use /tmp. Only seeded on virtual machines,
# and never over the user's own flags.
seed_vm_electron_flags() {
  systemd-detect-virt -q 2>/dev/null || return 0
  config_has desktop.electron_flags && return 0
  # A JSON list: a bare "--flag" value would be parsed as a CLI option.
  hermes_set desktop.electron_flags '["--no-sandbox","--disable-dev-shm-usage"]' \
    && say "OK: VM detected — Electron starts with --no-sandbox --disable-dev-shm-usage" \
    || say "WARN: could not set desktop.electron_flags"
}

# Seeded once (marker), and only when the user has not configured a chain:
# their own fallback_providers or model.provider always win.
seed_ollama_fallback() {
  local marker="$HERMES_HOME/.noctraos-seeded"
  [ -f "$marker" ] && return 0
  if ! ollama_ready; then
    say "Ollama/$OLLAMA_MODEL not ready — skipping local fallback (re-run: noctraos-hermes install)"
    return 0
  fi
  if config_has fallback_providers; then
    say "OK: fallback_providers already configured — leaving it alone"
  else
    hermes_set fallback_providers \
      "[{\"provider\":\"custom\",\"model\":\"$OLLAMA_MODEL\",\"base_url\":\"$OLLAMA_API/v1\",\"api_key\":\"ollama\"}]" \
      && say "OK: Ollama ($OLLAMA_MODEL) set as the local fallback" \
      || say "WARN: could not write fallback_providers"
  fi
  : > "$marker"
}

# Offline on a machine that has never minted a free-tier identity: there is
# nothing for the free tier to run on, so make local Ollama the primary.
offline_first_launch_fallback() {
  grep -q '"nous"' "$HERMES_HOME/auth.json" 2>/dev/null && return 0
  explicit_provider && return 0
  curl -fsS --max-time 4 -o /dev/null "$NOUS_URL" 2>/dev/null && return 0
  ollama_ready || return 0
  say "Offline and not yet connected to the free tier — using local Ollama"
  hermes_set model.provider custom
  hermes_set model.default "$OLLAMA_MODEL"
  hermes_set model.base_url "$OLLAMA_API/v1"
}

# Active until the agent drops the done marker; a prompt the user set themselves
# (env or agent.system_prompt) always wins, so we never shadow it.
onboarding_active() {
  [ -r "$ONBOARD_FILE" ] && [ ! -f "$ONBOARD_DONE" ] \
    && [ -z "${HERMES_EPHEMERAL_SYSTEM_PROMPT:-}" ] && ! config_has agent.system_prompt
}

cmd_install() {
  install_runtime || { say "ERROR: runtime install failed"; return 1; }
  build_app || { say "ERROR: desktop build failed"; return 1; }
  seed_ollama_fallback
  seed_vm_electron_flags
  hide_hermes_own_launcher
}

# Move an existing install to the newest published release. The runtime directory (code, venv, Electron app) is the only
# thing replaced: it is set aside first and put back if the new one does not come up, so a failed update leaves Hermes as
# it was. Everything a person made (config, memories, sessions, SOUL.md) lives in ~/.hermes outside that directory.
cmd_update() {
  if ! runtime_ready; then
    say "Hermes is not installed yet: installing the newest release."
    cmd_install
    return
  fi
  local tag want have previous free_kb
  tag="$(release_tag)" || tag=""
  want="$(release_version)" || want=""
  if [ -z "$tag" ] || [ -z "$want" ]; then
    say "ERROR: could not read the newest Hermes release (no connection, or GitHub is limiting requests). Nothing was changed."
    return 1
  fi
  have="$(installed_version)" || have=""
  if [ -n "$have" ] && [ "$(printf '%s\n%s\n' "$want" "$have" | sort -V | tail -n 1)" = "$have" ]; then
    say "OK: Hermes $have is already the newest release ($want)."
    return 0
  fi
  if hermes_running; then
    say "ERROR: Hermes is running. Close Hermes Desktop (and any Hermes terminal session), then update. Nothing was changed."
    return 75
  fi
  free_kb="$(df -Pk "$HERMES_HOME" | awk 'NR==2 {print $4}')"
  if [ "${free_kb:-0}" -lt "${NOCTRAOS_HERMES_MIN_FREE_KB:-4000000}" ]; then
    say "ERROR: not enough free disk space for the update (about 4 GB needed). Nothing was changed."
    return 1
  fi
  say "Updating Hermes ${have:-?} to $want (release $tag)..."
  previous="$RUNTIME.previous"
  rm -rf "$previous"
  mv "$RUNTIME" "$previous" || { say "ERROR: cannot set the current Hermes aside. Nothing was changed."; return 1; }
  if install_runtime && build_app; then
    seed_ollama_fallback
    seed_vm_electron_flags
    hide_hermes_own_launcher
    rm -rf "$previous"
    say "OK: Hermes is now $(installed_version || echo "$want")."
    return 0
  fi
  say "ERROR: the update did not finish; putting the previous Hermes back."
  rm -rf "$RUNTIME"
  mv "$previous" "$RUNTIME" || { say "ERROR: could not restore $previous. Re-run: noctraos-hermes install"; return 1; }
  return 1
}

# Where prompts go: "cloud" (Nous free tier, they leave this computer), "local" (this machine's
# Ollama only, set by `local`) or "other" (the user's own provider). Read by `noc status --json`.
hermes_mode() {
  explicit_provider || { echo cloud; return; }
  if [ "$(config_get model.base_url)" = "$OLLAMA_API/v1" ]; then echo local; else echo other; fi
}

# Value of "section.key" one level down in config.yaml (empty when unset).
config_get() {
  local f="$HERMES_HOME/config.yaml"
  [ -f "$f" ] || return 0
  awk -v sec="${1%%.*}" -v k="${1#*.}" '
    $0 ~ "^"sec":" {m=1; next}
    /^[^ #\t]/ {m=0}
    m && $1 == k":" {sub("^[ \t]*"k":[ \t]*", ""); sub(/[ \t]*#.*$/, ""); gsub(/["\x27]/, ""); print; exit}' "$f"
}

cmd_status() {
  echo "mode:    $(hermes_mode)"
  runtime_ready && echo "runtime: ok ($RUNTIME)" || echo "runtime: missing"
  app_ready && echo "app:     ok" || echo "app:     not built"
  if explicit_provider; then echo "primary: explicit model.provider in config.yaml"
  else echo "primary: Nous free tier (no model.provider set)"; fi
  config_has fallback_providers && echo "fallback: configured" || echo "fallback: none"
  if [ -f "$ONBOARD_DONE" ]; then echo "onboarding: done"
  else echo "onboarding: tour pending"; fi
  ollama_ready && echo "ollama:  $OLLAMA_MODEL ready" || echo "ollama:  $OLLAMA_MODEL not ready"
}

# The free tier is Nous Research's cloud: prompts typed to Hermes leave this computer. This is
# the one-click way to keep them here. It is persistent (config.yaml); to go back to the free
# tier run `noctraos-hermes cloud`.
cmd_local() {
  local launch=1
  [ "${1:-}" = "--no-launch" ] && launch=0   # the Control Panel switches the mode without opening the app
  if ! ollama_ready; then
    say "ERROR: the local model $OLLAMA_MODEL is not ready yet — try again in a few minutes"
    return 1
  fi
  hermes_set model.provider custom
  hermes_set model.default "$OLLAMA_MODEL"
  hermes_set model.base_url "$OLLAMA_API/v1"
  say "OK: Hermes will use the local model only (Nous free tier off)"
  [ "$launch" -eq 1 ] || return 0
  LOCAL_ONLY=1 cmd_launch
}

# The inverse of `local`: back to Hermes' stock provider (auto), which brings the Nous free tier
# back. Undoes the three keys `local` wrote, and only when they point at this machine's Ollama,
# so a provider the user configured themselves is never touched.
cmd_cloud() {
  if [ "$(hermes_mode)" = other ]; then
    say "ERROR: model.provider is set to your own provider — leaving it alone"
    return 1
  fi
  if [ "$(hermes_mode)" = local ]; then
    "$HERMES_BIN" config unset model.base_url >/dev/null 2>&1 || true
    "$HERMES_BIN" config unset model.default >/dev/null 2>&1 || true
  fi
  hermes_set model.provider auto
  say "OK: Hermes is back on the Nous free tier (prompts leave this computer)"
}

cmd_launch() {
  if ! runtime_ready || ! app_ready; then
    # Desktop entries have no terminal; first-run install needs one to show progress.
    if [ ! -t 1 ]; then
      exec gnome-terminal --title="Setting up Hermes" -- "$0" launch
    fi
    say "Hermes Desktop is not installed yet — installing now."
    cmd_install || { read -r -n 1 -s -p "Press any key to close..."; exit 1; }
  fi
  offline_first_launch_fallback
  seed_vm_electron_flags
  hide_hermes_own_launcher
  # Local-only never enables the free tier: it would still contact Nous for its identity.
  if [ "${LOCAL_ONLY:-}" != 1 ]; then
    export HERMES_GUEST_ONBOARDING=1
  fi
  if onboarding_active; then
    HERMES_EPHEMERAL_SYSTEM_PROMPT="$(cat "$ONBOARD_FILE")"
    export HERMES_EPHEMERAL_SYSTEM_PROMPT
  fi
  exec "$HERMES_BIN" desktop --skip-build
}

case "${1:-launch}" in
  launch)  cmd_launch ;;
  local)   shift; cmd_local "$@" ;;
  cloud)   cmd_cloud ;;
  mode)    hermes_mode ;;
  install) cmd_install ;;
  update)  cmd_update ;;
  ready)   runtime_ready && app_ready ;;
  status)  cmd_status ;;
  *) echo "usage: noctraos-hermes [launch|local|cloud|mode|install|update|ready|status]" >&2; exit 1 ;;
esac
