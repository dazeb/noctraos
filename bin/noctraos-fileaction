#!/usr/bin/env bash
# Dolphin right-click action runner (flavour kubuntu). Dolphin hands the selection over as arguments (%F), while the
# NoctraOS file actions were written for Nautilus, which uses environment variables; this turns one into the other
# and runs the same script, so "Open in VS Code" and "Ask AI to Explain" behave the same on both desktops.
#   noctraos-fileaction open-in-vscode|ask-ai|terminal-here <path>...
set -u
action="${1:-}"
[ "$#" -gt 0 ] && shift
SCRIPTS="${NOCTRAOS_FILE_ACTIONS:-${XDG_DATA_HOME:-$HOME/.local/share}/noctraos/file-actions}"

selected=""
for p in "$@"; do
  p="${p#file://}"
  selected+="${p}"$'\n'
done
export NAUTILUS_SCRIPT_SELECTED_FILE_PATHS="$selected"
first="$(head -n 1 <<<"$selected")"
if [ -d "$first" ]; then
  NAUTILUS_SCRIPT_CURRENT_DIR="$first"
elif [ -n "$first" ]; then
  NAUTILUS_SCRIPT_CURRENT_DIR="$(dirname "$first")"
else
  NAUTILUS_SCRIPT_CURRENT_DIR="$HOME"
fi
export NAUTILUS_SCRIPT_CURRENT_DIR

case "$action" in
  open-in-vscode) exec "$SCRIPTS/Open in VS Code" ;;
  ask-ai)         exec "$SCRIPTS/Ask AI to Explain" ;;
  terminal-here)
    dir="$NAUTILUS_SCRIPT_CURRENT_DIR"
    if command -v konsole >/dev/null 2>&1; then
      exec konsole --workdir "$dir"
    fi
    cd "$dir" && exec x-terminal-emulator ;;
  *) echo "usage: noctraos-fileaction open-in-vscode|ask-ai|terminal-here <path>..." >&2; exit 2 ;;
esac
