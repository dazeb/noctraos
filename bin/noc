#!/usr/bin/env bash
# noc — noctraos workstation management CLI.
#   noc update        apt + Flatpak + mise runtimes + AI models
#   noc doctor        health check of the whole stack
#   noc models        list | pull <model> | rm <model> | gui
#   noc gpu           detect | install | status  (NVIDIA CUDA / AMD ROCm for local LLMs)
set -uo pipefail

VERSION="0.3.0"
OLLAMA_URL="http://127.0.0.1:11434"
MODEL_PRESETS=("qwen2.5-coder:7b" "qwen2.5-coder:14b" "llama3.2:3b" "gemma2:2b" "deepseek-coder:6.7b" "phi4-mini")

ok()   { printf '  \033[32mOK\033[0m  %s\n' "$*"; }
bad()  { printf '  \033[31m!!\033[0m  %s\n' "$*"; }
info() { printf '\033[1;36mnoc\033[0m %s\n' "$*"; }

WALLPAPER_DIR="/usr/local/share/backgrounds/noctraos"

# gsettings needs the user's session bus; detect it when run over ssh.
with_bus() {
  if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    "$@"
  else
    env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus" "$@"
  fi
}

current_bg() {
  with_bus gsettings get org.gnome.desktop.background picture-uri-dark 2>/dev/null \
    | tr -d "'"
}

cmd_bg() {
  local action="${1:-list}"
  case "$action" in
    list)
      local cur
      cur="$(current_bg)"
      local f
      for f in "$WALLPAPER_DIR"/*.jpg; do
        [ -f "$f" ] || continue
        if [ "$f" = "$cur" ]; then
          echo "  * $(basename "$f")"
        else
          echo "    $(basename "$f")"
        fi
      done
      ;;
    set)
      local f="${2:-}"
      [ -z "$f" ] && { echo "usage: noc bg set <filename-or-path>"; exit 1; }
      [ -f "$f" ] || f="$WALLPAPER_DIR/$(basename "$f")"
      [ -f "$f" ] || { bad "no such wallpaper: $2"; exit 1; }
      with_bus gsettings set org.gnome.desktop.background picture-uri "file://$f"
      with_bus gsettings set org.gnome.desktop.background picture-uri-dark "file://$f"
      info "background set: $(basename "$f")"
      ;;
    next)
      local cur next="" f
      cur="$(current_bg)"
      for f in "$WALLPAPER_DIR"/*.jpg; do
        [ -f "$f" ] || continue
        if [ -n "$next" ]; then
          cur=""; next="$f"; break
        elif [ "$f" = "$cur" ] || [ -z "$cur" ]; then
          next="pending"
        fi
      done
      [ -n "$next" ] && [ "$next" != "pending" ] || next="$(ls "$WALLPAPER_DIR"/*.jpg 2>/dev/null | head -n 1)"
      [ -n "$next" ] || { bad "no wallpapers in $WALLPAPER_DIR"; exit 1; }
      cmd_bg set "$next"
      ;;
    *)
      echo "usage: noc bg [list | next | set <name>]"
      ;;
  esac
}

cmd_update() {
  info "1/4  apt packages"
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get upgrade -y

  info "2/4  Flatpak applications"
  if command -v flatpak >/dev/null 2>&1; then
    flatpak update -y --noninteractive 2>/dev/null \
      || sudo flatpak update -y --noninteractive || true
  fi

  info "3/4  mise runtimes"
  if command -v mise >/dev/null 2>&1; then
    mise up -y 2>/dev/null || mise install || true
  else
    bad "mise not found"
  fi

  info "4/4  Ollama models (refresh every installed model)"
  if command -v ollama >/dev/null 2>&1 \
     && curl -fsS --max-time 5 "$OLLAMA_URL/api/tags" >/dev/null 2>&1; then
    while IFS= read -r m; do
      [ -z "$m" ] && continue
      info "     pulling $m"
      ollama pull "$m" || bad "pull failed: $m"
    done < <(ollama list 2>/dev/null | awk 'NR>1 {print $1}')
  else
    bad "Ollama not responding — skipped model refresh"
  fi

  info "Update complete."
}

cmd_doctor() {
  echo "NoctraOS doctor"
  echo "----------------"

  if [ -r /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    ok "OS: ${PRETTY_NAME:-$ID}"
  else
    bad "OS: unknown"
  fi

  if curl -fsS --max-time 5 "$OLLAMA_URL/api/version" >/dev/null 2>&1; then
    ok "Ollama: running ($(curl -fsS "$OLLAMA_URL/api/version" | jq -r .version 2>/dev/null))"
    model_count="$(curl -fsS "$OLLAMA_URL/api/tags" | jq '.models | length' 2>/dev/null || echo 0)"
    ok "Ollama: $model_count local model(s)"
  else
    bad "Ollama: not responding on $OLLAMA_URL (try: systemctl status ollama)"
  fi

  if command -v mise >/dev/null 2>&1; then
    ok "mise: $(mise --version 2>/dev/null | head -n 1)"
    mise ls 2>/dev/null | sed 's/^/       /' || true
    node_v="$(mise exec -- node --version 2>/dev/null || true)"
    py_v="$(mise exec -- python --version 2>/dev/null || true)"
    go_v="$(mise exec -- go version 2>/dev/null | awk '{print $3}' || true)"
    [ -n "$node_v" ] && ok "node $node_v (mise)"   || bad "node: not resolving via mise"
    [ -n "$py_v" ]   && ok "$py_v (mise)"          || bad "python: not resolving via mise"
    [ -n "$go_v" ]   && ok "go $go_v (mise)"       || bad "go: not resolving via mise"
    herdr_v="$(mise where herdr >/dev/null 2>&1 && mise exec herdr -- herdr --version 2>/dev/null | head -n 1 || true)"
    [ -n "$herdr_v" ] && ok "Herdr: $herdr_v" || bad "Herdr: missing from mise"
    starship_v="$(mise where starship >/dev/null 2>&1 && mise exec starship -- starship --version 2>/dev/null | head -n 1 || true)"
    [ -n "$starship_v" ] && ok "Starship: $starship_v" || bad "Starship: missing from mise"
    for tool in lazygit lazydocker; do
      mise where "$tool" >/dev/null 2>&1 \
        && ok "$tool: installed via mise" || bad "$tool: missing from mise"
    done
  else
    bad "mise: not installed"
  fi

  if command -v code >/dev/null 2>&1; then
    ok "VS Code: $(code --version 2>/dev/null | head -n 1)"
  else
    bad "VS Code: missing"
  fi

  if command -v noctraos-search >/dev/null 2>&1 \
     && [ -d /usr/share/gnome-shell/extensions/noctraos-search@noctraos.local ]; then
    ok "Super+Space search: installed"
  else
    bad "Super+Space search: missing (re-run the installer)"
  fi

  if command -v noctraos-hermes >/dev/null 2>&1; then
    hs="$(noctraos-hermes status 2>/dev/null || true)"
    if printf '%s\n' "$hs" | grep -q '^runtime: ok' && printf '%s\n' "$hs" | grep -q '^app:     ok'; then
      ok "Hermes Desktop: installed ($(printf '%s\n' "$hs" | sed -n 's/^primary: //p'))"
    else
      bad "Hermes Desktop: not fully installed (run: noctraos-hermes install)"
    fi
  else
    bad "Hermes Desktop: launcher missing (re-run the installer)"
  fi

  if command -v flatpak >/dev/null 2>&1; then
    flatpak list --app 2>/dev/null | grep -q MissionCenter \
      && ok "Mission Center: installed" || bad "Mission Center: missing"
  fi

  if [ -x /usr/local/bin/app-manager ]; then
    ok "AppManager: $(cat /opt/appmanager/VERSION 2>/dev/null || echo installed)"
  else
    bad "AppManager: missing (run: bash ~/.local/share/noctraos/install/04_appmanager.sh)"
  fi
  if dpkg-query -W libfuse2t64 >/dev/null 2>&1 || dpkg-query -W libfuse2 >/dev/null 2>&1; then
    ok "FUSE 2: installed (AppImages can mount)"
  else
    bad "FUSE 2: libfuse2 missing — most AppImages will not start"
  fi

  if command -v noc-gpu >/dev/null 2>&1; then
    noc-gpu status || true
  elif command -v nvidia-smi >/dev/null 2>&1; then
    ok "GPU: NVIDIA $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n 1)"
  else
    info "GPU: noc-gpu not installed and no NVIDIA driver detected — Ollama will run on CPU"
  fi

  ok "Disk free on /: $(df -h / | awk 'NR==2 {print $4}')"
  echo "----------------"
  echo "done."
}

cmd_models() {
  local action="${1:-list}"
  case "$action" in
    list)
      ollama list
      ;;
    pull)
      local m="${2:-}"
      [ -z "$m" ] && { echo "usage: noc models pull <model>"; exit 1; }
      ollama pull "$m"
      ;;
    rm|remove|delete)
      local m="${2:-}"
      [ -z "$m" ] && { echo "usage: noc models rm <model>"; exit 1; }
      ollama rm "$m"
      ;;
    gui)
      command -v zenity >/dev/null 2>&1 || { bad "zenity not available"; exit 1; }
      local choice
      choice="$(zenity --list \
        --title="NoctraOS — download a model" \
        --text="Pick a model to pull from the Ollama library" \
        --column="Model" --column="Note" \
        "${MODEL_PRESETS[0]}" "Default: fast local coding model" \
        "${MODEL_PRESETS[1]}" "Bigger, smarter (needs ~16 GB RAM)" \
        "${MODEL_PRESETS[2]}" "Small general chat" \
        "${MODEL_PRESETS[3]}" "Tiny general chat" \
        "${MODEL_PRESETS[4]}" "Alternative coding model" \
        "${MODEL_PRESETS[5]}" "Small, fast model" \
        --width=520 --height=400 2>/dev/null)" || exit 0
      [ -n "$choice" ] && ollama pull "$choice"
      ;;
    *)
      echo "usage: noc models [list | pull <model> | rm <model> | gui]"
      ;;
  esac
}

case "${1:-help}" in
  update) cmd_update ;;
  doctor) cmd_doctor ;;
  models) shift; cmd_models "$@" ;;
  bg)     shift; cmd_bg "$@" ;;
  gpu)    shift; command -v noc-gpu >/dev/null 2>&1 && exec noc-gpu "$@" \
            || { bad "noc-gpu not installed (re-run the installer)"; exit 1; } ;;
  --version|-v) echo "noc $VERSION" ;;
  *)
    echo "noc $VERSION — NoctraOS workstation manager"
    echo ""
    echo "  noc update      update apt, Flatpak apps, mise runtimes, AI models"
    echo "  noc doctor      health check of the whole stack"
    echo "  noc models      manage local AI models (list | pull | rm | gui)"
    echo "  noc bg          cycle or set the wallpaper (list | next | set)"
    echo "  noc gpu         GPU setup for local LLMs (detect | install | status)"
    echo "  noc-menu        the same maintenance tasks from a GUI panel"
    ;;
esac
