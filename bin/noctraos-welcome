#!/usr/bin/python3
# System Python on purpose: it has PyGObject; a mise-managed python3 (first on PATH in a
# session) does not. Same reason bin/noctraos-search execs /usr/bin/python3.
"""noctraos-welcome — the first-run welcome (design: docs/onboarding.md).

  noctraos-welcome                 show once per account (marker in ~/.config/noctraos)
  noctraos-welcome --force         show again (the start-menu entry)
  noctraos-welcome --provisioning  started by the first-boot runner while setup still runs

Four short screens, always skippable: what NoctraOS is, press Windows+Space (the screen
moves on when you do), where familiar things are, and your local AI with a button to meet
Hermes. System Python + PyGObject, like the Search settings window; no new runtime.
"""
import json
import os
import subprocess
import sys
import threading
import urllib.request
from pathlib import Path

import gi

gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = 'local.noctraos.Welcome'
SEARCH_SCHEMA = 'org.gnome.shell.extensions.noctraos-search'
MARKER = Path(GLib.get_user_config_dir()) / 'noctraos' / 'welcome-done'
PROVISIONED = Path.home() / '.local/share/noctraos/.provisioned'
HERMES = '/usr/local/bin/noctraos-hermes'
MODEL = os.environ.get('NOCTRAOS_MODEL', 'qwen2.5-coder:7b')
OLLAMA_TAGS = 'http://127.0.0.1:11434/api/tags'

CSS = b"""
window, .welcome { background: #121212; color: #bebebe; }
.title { font-size: 28px; font-weight: bold; color: #eaeaea; }
.lede { font-size: 15px; color: #bebebe; }
.muted { color: #8a8a8d; }
.hint { color: #e68e0d; }
.keycap { background: #1e1e1e; border: 1px solid #333333; border-bottom: 3px solid #e68e0d;
          border-radius: 2px; padding: 16px 28px; color: #eaeaea; font-size: 22px;
          font-family: 'JetBrainsMono Nerd Font', monospace; }
.plus { font-size: 22px; color: #8a8a8d; }
.row { border-bottom: 1px solid #333333; padding: 10px 4px; }
.row-name { color: #e68e0d; font-weight: bold; }
.bar { background: #0d0d0d; border-top: 1px solid #333333; }
button { background-image: none; background: #1e1e1e; color: #bebebe; border: 1px solid #333333;
         border-radius: 2px; padding: 8px 20px; box-shadow: none; text-shadow: none; }
button:hover { background: #2a2a2a; }
button:disabled { color: #555555; }
button.suggested-action { background: #e68e0d; color: #121212; border-color: #e68e0d; font-weight: bold; }
button.suggested-action:disabled { background: #3a2a10; color: #7a6a50; border-color: #3a2a10; }
button.link { background: none; border: none; color: #8a8a8d; padding: 8px 4px; }
button.link:hover { color: #eaeaea; }
"""


def label(text, *classes, xalign=0.5, wrap=True):
    item = Gtk.Label(label=text, xalign=xalign, wrap=wrap, justify=Gtk.Justification.CENTER
                     if xalign == 0.5 else Gtk.Justification.LEFT)
    for name in classes:
        item.get_style_context().add_class(name)
    return item


def page_box():
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, halign=Gtk.Align.CENTER,
                  valign=Gtk.Align.CENTER, margin=40)
    box.set_size_request(560, -1)
    return box


class Welcome(Gtk.ApplicationWindow):
    def __init__(self, app, provisioning):
        super().__init__(application=app, title='Welcome to NoctraOS')
        self.set_default_size(780, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name('noctraos-start')
        self.get_style_context().add_class('welcome')
        self.provisioning = provisioning
        self.index = 0
        self.used = False
        self.settings = self._search_settings()
        if self.settings:
            self.used = self.settings.get_boolean('first-used')
            self.settings.connect('changed::first-used', self._on_used)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               transition_duration=220, vexpand=True)
        outer.pack_start(self.stack, True, True, 0)
        self.pages = [self._page_welcome(), self._page_keys(), self._page_map(), self._page_ai()]
        for number, page in enumerate(self.pages):
            self.stack.add_named(page, str(number))

        bar = Gtk.Box(spacing=12, margin=14)
        bar.get_style_context().add_class('bar')
        self.skip = Gtk.Button(label='Skip')
        self.skip.get_style_context().add_class('link')
        self.skip.connect('clicked', lambda *_: self.finish())
        self.status = label('', 'muted', xalign=0, wrap=False)
        self.back = Gtk.Button(label='Back')
        self.back.connect('clicked', lambda *_: self.go(self.index - 1))
        self.next = Gtk.Button(label='Start')
        self.next.get_style_context().add_class('suggested-action')
        self.next.connect('clicked', self._on_next)
        bar.pack_start(self.skip, False, False, 0)
        bar.pack_start(self.status, True, True, 8)
        bar.pack_end(self.next, False, False, 0)
        bar.pack_end(self.back, False, False, 0)
        outer.pack_end(bar, False, False, 0)

        self.connect('key-press-event', self._on_key)
        self.go(0)
        self._poll()
        GLib.timeout_add_seconds(3, self._poll)

    # -- pages -------------------------------------------------------------------------
    def _page_welcome(self):
        box = page_box()
        box.pack_start(label('Welcome to NoctraOS', 'title'), False, False, 0)
        box.pack_start(label('An AI-first desktop for people moving from Windows. Your AI runs on '
                             'this computer, and nothing leaves it unless you say so.', 'lede'),
                       False, False, 0)
        box.pack_start(label('This takes about two minutes. You can skip any time.', 'muted'),
                       False, False, 0)
        return box

    def _page_keys(self):
        box = page_box()
        box.pack_start(label('Press Windows + Space', 'title'), False, False, 0)
        keys = Gtk.Box(spacing=14, halign=Gtk.Align.CENTER)
        keys.pack_start(label('Windows', 'keycap', wrap=False), False, False, 0)
        keys.pack_start(label('+', 'plus', wrap=False), False, False, 0)
        keys.pack_start(label('Space', 'keycap', wrap=False), False, False, 0)
        box.pack_start(keys, False, False, 8)
        box.pack_start(label('Search everything from one place: apps, files, clipboard history '
                             'and the web.', 'lede'), False, False, 0)
        self.key_hint = label('Try it now. This screen moves on when you do.', 'hint')
        box.pack_start(self.key_hint, False, False, 0)
        self.stuck = Gtk.Button(label="It's not working")
        self.stuck.get_style_context().add_class('link')
        self.stuck.set_halign(Gtk.Align.CENTER)
        self.stuck.connect('clicked', self._on_stuck)
        box.pack_start(self.stuck, False, False, 0)
        self.stuck_help = label('Some keyboards, laptops and remote sessions swallow this shortcut. '
                                'You can also use the search box in the Start menu (the N at the '
                                'bottom-left), and change the shortcut in Search settings.', 'muted')
        self.stuck_help.set_no_show_all(True)
        box.pack_start(self.stuck_help, False, False, 0)
        return box

    def _page_map(self):
        box = page_box()
        box.pack_start(label('Where familiar things are', 'title'), False, False, 0)
        rows = [
            ('Start button', 'The N at the bottom-left. Apps, search, power.'),
            ('Task Manager', 'Mission Center, pinned in the taskbar.'),
            ('File Explorer', 'Files, pinned in the taskbar.'),
            ('Screenshots', 'The Print key opens the screenshot tool.'),
            ('System tray', 'Network, sound and power, top right.'),
        ]
        for name, text in rows:
            row = Gtk.Box(spacing=18)
            row.get_style_context().add_class('row')
            title = label(name, 'row-name', xalign=0, wrap=False)
            title.set_size_request(150, -1)
            row.pack_start(title, False, False, 0)
            row.pack_start(label(text, xalign=0), True, True, 0)
            box.pack_start(row, False, False, 0)
        return box

    def _page_ai(self):
        box = page_box()
        box.pack_start(label('Your AI is local', 'title'), False, False, 0)
        box.pack_start(label('NoctraOS runs a language model on this computer, so it works offline '
                             'and your files stay yours. Agents live in Start > Agents.', 'lede'),
                       False, False, 0)
        self.model_status = label('', 'hint')
        box.pack_start(self.model_status, False, False, 0)
        self.hermes = Gtk.Button(label='Meet Hermes, your AI agent')
        self.hermes.get_style_context().add_class('suggested-action')
        self.hermes.set_halign(Gtk.Align.CENTER)
        self.hermes.connect('clicked', self._on_hermes)
        box.pack_start(self.hermes, False, False, 8)
        box.pack_start(label('Hermes is free to start. It will ask who you are and how you want it '
                             'to behave, then offer a short tour.', 'muted'), False, False, 0)
        return box

    # -- navigation --------------------------------------------------------------------
    def go(self, index):
        self.index = max(0, min(index, len(self.pages) - 1))
        self.stack.set_visible_child_name(str(self.index))
        self.back.set_visible(self.index > 0)
        self.next.set_label('Start' if self.index == 0 else 'Done' if self.index == 3 else 'Next')
        self.next.set_sensitive(self.index != 1 or self.used)
        if self.index == 1 and self.used:
            self.key_hint.set_text("You've done it.")

    def _on_next(self, *_):
        if self.index == len(self.pages) - 1:
            self.finish()
        else:
            self.go(self.index + 1)

    def _on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.finish()
            return True
        return False

    def finish(self):
        try:
            MARKER.parent.mkdir(parents=True, exist_ok=True)
            MARKER.touch()
        except OSError:
            pass
        self.get_application().quit()

    # -- the Windows+Space step ----------------------------------------------------------
    def _search_settings(self):
        source = Gio.SettingsSchemaSource.get_default()
        if source is None or source.lookup(SEARCH_SCHEMA, True) is None:
            return None
        settings = Gio.Settings.new(SEARCH_SCHEMA)
        # The key arrives with the search extension; an older schema just never advances.
        return settings if 'first-used' in settings.list_keys() else None

    def _on_used(self, settings, _key):
        self.used = settings.get_boolean('first-used')
        if self.used and self.index == 1:
            self.key_hint.set_text("That's it.")
            self.next.set_sensitive(True)
            GLib.timeout_add(900, lambda: (self.index == 1 and self.go(2)) and False)

    def _on_stuck(self, *_):
        self.stuck_help.set_no_show_all(False)
        self.stuck_help.show()
        self.next.set_sensitive(True)

    # -- Hermes + live status --------------------------------------------------------------
    def _on_hermes(self, *_):
        self.finish_launch = True
        subprocess.Popen([HERMES], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        self.finish()

    def _poll(self):
        threading.Thread(target=self._check, daemon=True).start()
        return True

    def _check(self):
        ready = None
        try:
            with urllib.request.urlopen(OLLAMA_TAGS, timeout=1.5) as reply:
                names = [m.get('name', '') for m in json.load(reply).get('models', [])]
            ready = any(n == MODEL or n.startswith(MODEL + ':') for n in names)
        except Exception:
            pass
        GLib.idle_add(self._show_status, ready, PROVISIONED.exists(), os.access(HERMES, os.X_OK))

    def _show_status(self, ready, provisioned, hermes_ready):
        if ready:
            self.model_status.set_text('Local model ready: ' + MODEL)
        elif provisioned:
            self.model_status.set_text('No local model yet. Open AI Models from the Start menu.')
        else:
            self.model_status.set_text('Finishing setup in the background. The local model is '
                                       'still downloading.')
        if provisioned:
            self.status.set_text('')
        else:
            self.status.set_text('Setting up your AI workstation in the background. '
                                 'You can keep this open.' if self.provisioning else
                                 'Setup is still finishing in the background.')
        self.hermes.set_sensitive(hermes_ready)
        self.hermes.set_tooltip_text(None if hermes_ready else 'Hermes is still being set up.')
        return False


class App(Gtk.Application):
    def __init__(self, provisioning):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.provisioning = provisioning

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        window = self.props.active_window or Welcome(self, self.provisioning)
        window.show_all()
        # show_all() un-hides what the first screen keeps hidden (Back, the help text).
        window.stuck_help.hide()
        window.go(window.index)
        window.present()


def main(argv):
    force = '--force' in argv
    # Not in the live installer session (people there are trying the installer), and once only.
    if not force:
        try:
            if 'casper' in Path('/proc/cmdline').read_text():
                return 0
        except OSError:
            pass
        if MARKER.exists():
            return 0
    return App('--provisioning' in argv).run([argv[0]])


if __name__ == '__main__':
    sys.exit(main(sys.argv))
