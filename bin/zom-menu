#!/usr/bin/env bash
# zom-menu — zenity control panel for zorin-ai (mouse-first maintenance).
set -u

term_run() {
  local cmd="$1" follow="echo; read -n 1 -s -r -p 'Done — press any key to close...'"
  if command -v gnome-terminal >/dev/null 2>&1; then
    gnome-terminal -- bash -lc "$cmd; $follow"
  elif command -v x-terminal-emulator >/dev/null 2>&1; then
    x-terminal-emulator -e bash -lc "$cmd; $follow"
  else
    bash -lc "$cmd"
  fi
}

while true; do
  choice="$(zenity --list \
    --title="zorin-ai control panel" \
    --column="Action" --column="What it does" \
    "Update everything"     "apt, Flatpak apps, mise runtimes, AI models" \
    "Health check (doctor)" "Verify Ollama, mise, VS Code, Flatpaks, GPU, disk" \
    "Manage AI models"      "Download models from a GUI picker" \
    "About"                 "About zorin-ai" \
    --width=560 --height=340 2>/dev/null)" || exit 0

  case "$choice" in
    "Update everything")     term_run "zom update" ;;
    "Health check (doctor)") term_run "zom doctor" ;;
    "Manage AI models")      term_run "zom models gui" ;;
    "About")
      zenity --info \
        --title="zorin-ai" \
        --text="zorin-ai provisioner\nMouse-first AI developer workstation for Zorin OS.\n\nManage from a terminal with: zom" \
        --width=420 2>/dev/null
      ;;
  esac
done
