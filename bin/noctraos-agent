#!/usr/bin/env bash
# noctraos-agent — launch an AI coding agent from the menu, installing it
# on first use. Usage: noctraos-agent <codex|claude|opencode|grok|gemini|qwen> [args...]
set -u

AGENT="${1:-}"; shift || true

# mise-managed node/npm lives behind the profile hooks; pull it in for this
# non-login shell so npm and the agent shims resolve.
if [ -f /etc/profile.d/noctraos-mise.sh ]; then
  # shellcheck disable=SC1091
  . /etc/profile.d/noctraos-mise.sh
fi

declare -A PKG=(
  [codex]="npm:@openai/codex"
  [claude]="npm:@anthropic-ai/claude-code"
  [opencode]="npm:opencode-ai"
  [grok]="npm:@vibe-kit/grok-cli"
  [gemini]="npm:@google/gemini-cli"
  [qwen]="npm:@qwen-code/qwen-code"
)

if [ -z "$AGENT" ] || [ -z "${PKG[$AGENT]:-}" ]; then
  echo "usage: noctraos-agent <codex|claude|opencode|grok|gemini|qwen> [args...]" >&2
  exit 1
fi

if ! command -v "$AGENT" >/dev/null 2>&1; then
  echo "$AGENT is not installed yet."
  if command -v zenity >/dev/null 2>&1; then
    zenity --question --no-wrap \
      --text="$AGENT is not installed.\n\nInstall it now with npm (needs node — included with noctraos)?" \
      || exit 1
  fi
  if ! command -v npm >/dev/null 2>&1; then
    echo "npm not found — install node first (mise: 'mise install node')." >&2
    read -r -n 1 -s -p "Press any key to close..."
    exit 1
  fi
  spec="${PKG[$AGENT]}"
  pkg="${spec#npm:}"
  echo "Installing $pkg ..."
  npm install -g "$pkg" || {
    echo "install failed"
    read -r -n 1 -s -p "Press any key to close..."
    exit 1
  }
fi

exec "$AGENT" "$@"
