# NoctraOS unattended-install preseed (Ubiquity/d-i).
# Template — iso/build-noctraos-iso.sh substitutes the @VARS@ from build-time
# environment (NOCTRAOS_*) and bakes the result into the ISO at
# /preseed/noctraos.seed. NOTE: the baked seed contains the user's password
# hash — anyone holding the ISO can read it. Only bake throwaway credentials.

# --- locale / console ------------------------------------------------------
d-i debian-installer/locale string @LOCALE@
d-i console-setup/ask_detect boolean false
d-i keyboard-configuration/layoutcode string @KEYMAP@
d-i keyboard-configuration/modelcode string pc105

# --- network (live session is already up; keep netcfg quiet) ---------------
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string @HOSTNAME@
d-i netcfg/get_domain string localdomain

# --- clock -----------------------------------------------------------------
d-i clock-setup/utc-auto boolean true
d-i time/zone string @TIMEZONE@

# --- user account (member of sudo → firstboot provisioning works) ---------
d-i passwd/user-fullname string @FULLNAME@
d-i passwd/username string @USERNAME@
d-i passwd/user-password-crypted password @PASSWORD_CRYPT@
d-i passwd/user-default-groups string adm cdrom dialout lpadmin plugdev sambashare sudo

# --- partitioning: use the whole disk, one ext4 root + swap ("atomic") -----
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman/mount_style select uuid

# --- bootloader ------------------------------------------------------------
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean true

# --- ubiquity behaviour: no summary screen, reboot when done ---------------
ubiquity ubiquity/summary note
ubiquity ubiquity/reboot boolean true

# --- first wizard page ("Updates and other software") — found by boot test:
# without these the unattended flow stops on that page waiting for Continue --
ubiquity ubiquity/download_updates boolean true
ubiquity ubiquity/use_nonfree boolean true
ubiquity ubiquity/no_zorin_os_census boolean true
