{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "editor.background": "#0B0D14",
    "editor.foreground": "#F2F2F7",
    "editorCursor.foreground": "#FF2D95",
    "editor.selectionBackground": "#A124FF55",
    "sideBar.background": "#10121B",
    "activityBar.background": "#090B12",
    "statusBar.background": "#23152F",
    "statusBar.foreground": "#F2F2F7",
    "focusBorder": "#FF2D95",
    "terminal.background": "#0B0D14",
    "terminal.foreground": "#F2F2F7",
    "terminalCursor.foreground": "#FF2D95"
  },
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "git.enableSmartCommit": true,
  "extensions.autoCheckUpdates": true
}
