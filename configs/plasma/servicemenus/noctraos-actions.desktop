[Desktop Entry]
Type=Service
MimeType=all/allfiles;inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
Actions=OpenInVSCode;AskAI;OpenTerminalHere
X-KDE-Priority=TopLevel
X-KDE-Submenu=NoctraOS

[Desktop Action OpenInVSCode]
Name=Open in VS Code
Icon=com.visualstudio.code
Exec=noctraos-fileaction open-in-vscode %F

[Desktop Action AskAI]
Name=Ask AI to Explain
Icon=help-hint
Exec=noctraos-fileaction ask-ai %F

[Desktop Action OpenTerminalHere]
Name=Open Terminal Here
Icon=utilities-terminal
Exec=noctraos-fileaction terminal-here %F
