[Desktop Entry]
Type=Application
Name=Clipboard History (CopyQ)
Comment=Permanent clipboard history — runs in the tray
# The wrapper runs CopyQ as an X11 (XWayland) client (GNOME has no wlr-data-control, so a
# native-Wayland CopyQ records nothing) and sets its tray icon white. See bin/noctraos-copyq.
Exec=noctraos-copyq
Icon=copyq
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
NoDisplay=true
