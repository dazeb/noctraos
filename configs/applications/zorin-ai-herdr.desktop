[Desktop Entry]
Type=Application
Version=1.0
Name=Herdr
GenericName=Agent Session Manager
Comment=Persistent terminal workspaces for coding agents
Exec=gnome-terminal --title=Herdr -- /usr/local/bin/mise exec herdr -- herdr
Icon=zorin-ai-herdr
Categories=Development;
Terminal=false
StartupNotify=true
Keywords=agents;terminal;sessions;workspaces;herdr;
