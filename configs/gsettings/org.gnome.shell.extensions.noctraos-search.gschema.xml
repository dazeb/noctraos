<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.noctraos-search" path="/org/gnome/shell/extensions/noctraos-search/">
    <key name="toggle-search" type="as"><default>['&lt;Super&gt;space']</default><summary>Open Search</summary></key>
    <key name="apps" type="b"><default>true</default><summary>Search applications</summary></key>
    <key name="files" type="b"><default>true</default><summary>Search files and folders</summary></key>
    <key name="clipboard" type="b"><default>true</default><summary>Search CopyQ text history</summary></key>
    <key name="web" type="b"><default>true</default><summary>Offer web search</summary></key>
    <key name="roots" type="as"><default>['/']</default><summary>Folders to index</summary></key>
    <key name="hidden" type="b"><default>false</default><summary>Include hidden files</summary></key>
    <key name="history" type="b"><default>false</default><summary>Search browser history</summary></key>
    <key name="history-browsers" type="as"><default>[]</default><summary>Browsers whose history is searched</summary></key>
    <key name="history-setup" type="s"><choices><choice value='unset'/><choice value='configured'/><choice value='dismissed'/></choices><default>'unset'</default><summary>Whether the browser-history question has been answered</summary></key>
    <key name="contents" type="b"><default>false</default><summary>Index UTF-8 text file contents up to 128 KiB</summary></key>
    <key name="web-provider" type="s"><default>'DuckDuckGo'</default><summary>Search engine</summary></key>
    <key name="first-used" type="b"><default>false</default><summary>Set the first time the search overlay is opened (the welcome app watches it)</summary></key>
    <key name="max-results" type="i"><range min="5" max="30"/><default>12</default><summary>Maximum results per source</summary></key>
  </schema>
</schemalist>
