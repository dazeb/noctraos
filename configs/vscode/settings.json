{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.colorCustomizations": {
    "editor.background": "#121212",
    "editor.foreground": "#bebebe",
    "editorCursor.foreground": "#e68e0d",
    "editor.selectionBackground": "#2a2a2a",
    "editor.lineHighlightBackground": "#1e1e1e",
    "editorLineNumber.foreground": "#8a8a8d",
    "sideBar.background": "#0d0d0d",
    "sideBar.foreground": "#bebebe",
    "sideBar.border": "#333333",
    "activityBar.background": "#0d0d0d",
    "activityBar.foreground": "#bebebe",
    "activityBar.activeBorder": "#e68e0d",
    "statusBar.background": "#0d0d0d",
    "statusBar.foreground": "#bebebe",
    "titleBar.activeBackground": "#0d0d0d",
    "titleBar.activeForeground": "#bebebe",
    "tab.activeBackground": "#121212",
    "tab.inactiveBackground": "#0d0d0d",
    "tab.activeBorderTop": "#e68e0d",
    "focusBorder": "#e68e0d",
    "input.background": "#1e1e1e",
    "input.foreground": "#bebebe",
    "input.border": "#333333",
    "button.background": "#e68e0d",
    "button.foreground": "#0d0d0d",
    "list.activeSelectionBackground": "#2a2a2a",
    "list.activeSelectionForeground": "#bebebe",
    "panel.border": "#333333",
    "terminal.background": "#121212",
    "terminal.foreground": "#bebebe",
    "terminalCursor.foreground": "#e68e0d",
    "terminal.ansiBlack": "#121212",
    "terminal.ansiRed": "#d35f5f",
    "terminal.ansiGreen": "#ffc107",
    "terminal.ansiYellow": "#e68e0d",
    "terminal.ansiBlue": "#e68e0d",
    "terminal.ansiMagenta": "#d35f5f",
    "terminal.ansiCyan": "#bebebe",
    "terminal.ansiWhite": "#bebebe",
    "terminal.ansiBrightBlack": "#555555",
    "terminal.ansiBrightRed": "#b91c1c",
    "terminal.ansiBrightGreen": "#ffc107",
    "terminal.ansiBrightYellow": "#f59e0b",
    "terminal.ansiBrightBlue": "#f59e0b",
    "terminal.ansiBrightMagenta": "#b91c1c",
    "terminal.ansiBrightCyan": "#eaeaea",
    "terminal.ansiBrightWhite": "#eaeaea"
  },
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "git.enableSmartCommit": true,
  "extensions.autoCheckUpdates": true
}
